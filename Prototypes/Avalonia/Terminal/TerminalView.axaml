<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MissionPlanner.Prototypes.Avalonia.Terminal.TerminalView">

  <!-- Self-contained visual language (matches ../DemoApp/App.axaml and
       ../ConfigMotorTest/ConfigMotorTestView.axaml) since this UserControl has no
       App.axaml of its own once reused elsewhere. -->

  <UserControl.Resources>
    <SolidColorBrush x:Key="CardBg" Color="#171A21"/>
    <SolidColorBrush x:Key="CardBorder" Color="#262B36"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8B93A7"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="TerminalGreen" Color="#3DDC97"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.Card">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 2 10 0 #40000000"/>
    </Style>
    <Style Selector="Button.FilterChip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <!-- Rectangular, not pill-shaped - CornerRadius=6 matches every other button
           class in this app (Primary/Ghost/IconBox/etc.), per direct user feedback:
           the 999 pill radius used before wasn't wanted at all, in either state, not
           just inconsistent between them. See .okf/log.md. -->
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.FilterChip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1F2430"/>
    </Style>
    <Style Selector="Button.FilterChipActive">
      <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="Card" Padding="0">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="16,12">
        <Button Grid.Column="0" x:Name="FoldToggleButton" Click="OnFoldToggleClick"
                Background="Transparent" BorderThickness="0" Padding="0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="FoldToggleIcon" Text="▶" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
            <TextBlock Text=">_ Terminal" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button x:Name="FilterAllButton" Content="All" Tag="All" Click="OnFilterClick"
                  Classes="FilterChip FilterChipActive" FontSize="11" Padding="10,3"/>
          <Button x:Name="FilterInfoButton" Content="Info" Tag="Info" Click="OnFilterClick"
                  Classes="FilterChip" FontSize="11" Padding="10,3"/>
          <Button x:Name="FilterErrorButton" Content="Error" Tag="Error" Click="OnFilterClick"
                  Classes="FilterChip" FontSize="11" Padding="10,3"/>
        </StackPanel>
        <TextBlock Grid.Column="2" x:Name="LineCountText" Text="0 messages" FontSize="11"
                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
      </Grid>
      <Border x:Name="ConsoleContent" IsVisible="False" MaxHeight="220" BorderThickness="0,1,0,0" BorderBrush="{StaticResource CardBorder}">
        <ScrollViewer x:Name="ConsoleScroll">
          <TextBox x:Name="ConsoleTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Consolas,Menlo,monospace" FontSize="12"
                   Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource TerminalGreen}" Padding="16,10"
                   Text="(no messages yet)"/>
        </ScrollViewer>
      </Border>
    </DockPanel>
  </Border>
</UserControl>
