<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Terminal bundle - one of the per-tab bundles mirroring Mission Planner's own top-level
    screens (see ../DemoApp/README.md's "Bundles" section for the full list and how they're
    hosted). This one is complete: a live console showing STATUSTEXT from a connected
    MAVLinkInterface, extracted from ../DemoApp/MainWindow.axaml(.cs) where it originally
    lived, so it can be worked on (and reused) independently of the app shell.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="ReactiveUI" Version="24.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ExtLibs\ArduPilot\MissionPlanner.ArduPilot.csproj" />
  </ItemGroup>

</Project>
