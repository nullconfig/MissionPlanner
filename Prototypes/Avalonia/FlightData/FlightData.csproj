<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Flight Data bundle - one of the per-tab bundles mirroring Mission Planner's own
    top-level screens (see ../DemoApp/README.md's "Bundles" section). Real (non-mocked)
    live telemetry readout from a connected MAVLinkInterface's CurrentState - the same
    data GCSViews/FlightData.cs's HUD control data-binds to (see
    GCSViews/FlightData.Designer.cs, search "bindingSourceHud"). Does NOT yet include the
    HUD's artificial-horizon rendering or the map - see README.md for what's real here
    and what a contributor would need to add for closer 1:1 parity.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="ReactiveUI" Version="24.1.0" />
    <!-- Mapsui.Avalonia12, not the plain Mapsui.Avalonia package - this app targets
         Avalonia 12.1.1 and Mapsui's own docs are explicit that Avalonia 12 users need
         the "12" package (XAML/C# API is otherwise identical). Chosen over building a
         custom tile renderer or wrapping GMap.NET (WinForms-only, no Avalonia support)
         after a NuGet search turned up no other well-adopted Avalonia-native map
         control - see .okf/flight-data/overview.md. -->
    <PackageReference Include="Mapsui.Avalonia12" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ExtLibs\ArduPilot\MissionPlanner.ArduPilot.csproj" />
  </ItemGroup>

</Project>
