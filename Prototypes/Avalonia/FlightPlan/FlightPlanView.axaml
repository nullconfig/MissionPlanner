<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MissionPlanner.Prototypes.Avalonia.FlightPlan.FlightPlanView">

  <UserControl.Resources>
    <SolidColorBrush x:Key="CardBg" Color="#171A21"/>
    <SolidColorBrush x:Key="CardBorder" Color="#262B36"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8B93A7"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.Card">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 2 10 0 #40000000"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="Card">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420">
      <TextBlock Text="⚑  Flight Plan" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
      <TextBlock Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center">
        Not implemented in this prototype - a pure scaffold bundle waiting for a
        contributor. The real screen (GCSViews/FlightPlanner.cs) is a mission editor:
        a GMap.NET map for placing/reordering waypoints, geofences and rally points, and
        upload/download of MISSION_ITEM sequences over MAVLink to the connected vehicle.
        A native map control for Avalonia would be the first real dependency to solve here
        - nothing else in these bundles needed one yet.
      </TextBlock>
    </StackPanel>
  </Border>
</UserControl>
