<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.Prototypes.Avalonia.Parameters"
             x:Class="MissionPlanner.Prototypes.Avalonia.Parameters.ParametersView"
             x:DataType="vm:ParametersViewModel">

  <!--
    Chunk 1 of Config's real "Full Parameter List" page (GCSViews/ConfigurationView/
    ConfigRawParams.cs - see .okf/config-tuning/parameters/overview.md) - a live,
    searchable, read-only table of every real parameter on the connected vehicle, plus
    the real left-side parameter-group tree (ConfigRawParams.cs's treeView1/BuildTree(),
    added 2026-08-16 - see ParametersViewModel.cs's BuildGroupTree for the ported
    algorithm). Column set (Name/Value/Default/Units/Options/Desc) matches the real
    screen exactly, verified against ConfigRawParams.Designer.cs/.resx (2026-08-16 -
    chunk 1 originally shipped with a guessed, wrong column set:
    Name/Value/Units/DisplayName/Description). Deliberately not the DataGridView
    grid-editing/param-compare/save-load/Fav-favorites/action-panel feature set the real
    screen has; those are later chunks once this one's reviewed.

    Visual language (cards, dark palette, CardHeading) copied verbatim from
    ../DemoApp/App.axaml, same self-contained-per-bundle pattern every other bundle here
    follows - see ../../../.okf/modernization/design-system/ for the shared reference
    and why byte-identical copying (not retyping from memory) matters.
  -->

  <UserControl.Resources>
    <SolidColorBrush x:Key="CardBg" Color="#171A21"/>
    <SolidColorBrush x:Key="CardBorder" Color="#262B36"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8B93A7"/>
    <x:Double x:Key="ControlHeight">36</x:Double>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.Card">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 2 10 0 #40000000"/>
    </Style>
    <Style Selector="TextBlock.CardHeading">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#1F2430"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- DataGrid ships its own default theme, not this bundle's dark palette - override
         the parts that would otherwise show through as a light/default-themed table
         inside an otherwise all-dark card. -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="RowBackground" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="VerticalGridLinesBrush" Value="{StaticResource CardBorder}"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#1F2430"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#1F2430"/>
    </Style>

    <!-- Left-side parameter-group tree (ConfigRawParams.cs's treeView1/BuildTree()) -
         ships its own default theme too, same reasoning as DataGrid above. -->
    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#1F2430"/>
    </Style>
    <Style Selector="TreeViewItem:selected TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <!-- Right-side action panel (ConfigRawParams.cs's tableLayoutPanel1, Dock=Right) -
         real button/label/order verified against ConfigRawParams.Designer.cs/.resx, not
         guessed. Most of these are disabled: they need write-back, file I/O, or a live
         re-download that isn't built yet (see each button's own ToolTip.Tip below and
         .okf/config-tuning/parameters/overview.md's chunk list) - present for visual
         parity with the real screen, not faked as functional. -->
    <Style Selector="Button.SidebarAction">
      <Setter Property="Background" Value="#1F2430"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.SidebarAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#262B36"/>
    </Style>
    <Style Selector="Button.SidebarAction:disabled">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="TextBlock.SidebarNote">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4,0,10"/>
    </Style>
    <Style Selector="ComboBox.SidebarCombo">
      <Setter Property="Background" Value="#1F2430"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="CheckBox.SidebarCheck">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="Card" Padding="16">
    <DockPanel>

      <!-- Search lives here, not in the action panel below - a deliberate departure
           from ConfigRawParams.cs's real layout (its txt_search sits inside
           tableLayoutPanel1, docked right). Moved back to the top per direct user
           feedback: search is used far more often than the rest of the action panel,
           so it earns the prominent spot rather than being buried among disabled
           placeholder buttons. -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
        <TextBlock Grid.Column="0" Text="PARAMETERS" Classes="CardHeading" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding SearchText}" Watermark="Search parameters (matches any column, e.g. ATC_RAT)"
                  Height="{StaticResource ControlHeight}" MaxWidth="380" Margin="16,0"/>
        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}"
                   FontSize="12" VerticalAlignment="Center"/>
      </Grid>

      <!-- Tree (left) + grid (middle) + action panel (right), matching
           ConfigRawParams.cs's own splitContainer1 (Panel1 = treeView1, Panel2 = {Params,
           tableLayoutPanel1 Dock=Right}) - the real screen's three-pane layout, not a
           two-pane one with the sidebar bolted on separately. Selecting a tree node
           narrows the grid to that group's params (see ParametersViewModel's
           SelectedGroup/ApplyFilter) - not a separate pane that needs its own
           scroll/search, just another filter over the same Rows. -->
      <Grid ColumnDefinitions="200,12,*,12,200">
        <Border Grid.Column="0" Background="#12151B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6">
          <TreeView ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Padding="4">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" FontFamily="Consolas,Menlo,monospace"/>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>

        <DataGrid Grid.Column="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  CanUserReorderColumns="True" CanUserResizeColumns="True">
          <!-- Header text and order match the real ConfigRawParams.resx exactly
               (Name/Value/Default/Units/Options/Desc) - see ParametersViewModel.cs's
               ParameterRowViewModel for where each one's real data comes from. Fav
               (favorites checkbox) is the one real column not here yet - out of scope
               for this chunk, see the OKF bundle's "Next immediate step"/chunk list. -->
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" FontFamily="Consolas,Menlo,monospace"/>
            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="90"/>
            <DataGridTextColumn Header="Default" Binding="{Binding DefaultText}" Width="90"/>
            <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="70"/>
            <DataGridTextColumn Header="Options" Binding="{Binding Options}" Width="180"/>
            <DataGridTextColumn Header="Desc" Binding="{Binding Description}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Action panel - real control set/order verified against
             ConfigRawParams.Designer.cs's tableLayoutPanel1 (BUT_load through
             BUT_refreshTable, rows 0-16). Disabled buttons carry a ToolTip.Tip
             explaining what real chunk wires them up - not silently broken, just
             honestly not-yet-implemented. -->
        <Border Grid.Column="4" Background="#12151B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Button Classes="SidebarAction" Content="Load from file" IsEnabled="False"
                      ToolTip.Tip="Save/load .param files - not yet wired (see the Parameters overview's chunk list)."/>
              <Button Classes="SidebarAction" Content="Save to file" IsEnabled="False"
                      ToolTip.Tip="Save/load .param files - not yet wired (see the Parameters overview's chunk list)."/>

              <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,4,0,10"/>

              <Button Classes="SidebarAction" Content="Write Params" IsEnabled="False"
                      ToolTip.Tip="Needs in-place cell editing + setParamAsync write-back - the next chunk, not started yet."/>
              <Button Classes="SidebarAction" Content="Refresh Params" IsEnabled="False"
                      ToolTip.Tip="Real getParamList() re-download from the vehicle, gated behind an armed-vehicle warning on the real screen - not wired without that same safety gate."/>
              <Button Classes="SidebarAction" Content="Compare Params" IsEnabled="False"
                      ToolTip.Tip="Save/load .param files - not yet wired (see the Parameters overview's chunk list)."/>
              <Button Classes="SidebarAction" Content="Commit Params" IsEnabled="False"
                      ToolTip.Tip="Sends PREFLIGHT_STORAGE to the connected vehicle (commit RAM params to flash) - a real vehicle-mutating MAVLink command, deliberately not wired without dedicated review."/>

              <TextBlock Classes="SidebarNote" Text="All units are in raw format with no scaling"/>

              <ComboBox Classes="SidebarCombo" IsEnabled="False" PlaceholderText="Presaved defaults"/>
              <Button Classes="SidebarAction" Content="Load Presaved" IsEnabled="False"
                      ToolTip.Tip="Save/load .param files - not yet wired (see the Parameters overview's chunk list)."/>
              <Button Classes="SidebarAction" Content="Reset to Default" IsEnabled="False"
                      ToolTip.Tip="Needs in-place cell editing + setParamAsync write-back - the next chunk, not started yet."/>

              <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,4,0,10"/>

              <!-- Search itself lives in the header above, not here - see that
                   Grid's own comment. -->
              <CheckBox Classes="SidebarCheck" Content="Modified" IsEnabled="False"
                        ToolTip.Tip="Tracks in-place edits not yet written to the vehicle - needs the write-back chunk first."/>
              <CheckBox Classes="SidebarCheck" Content="None Default" IsChecked="{Binding ShowNoneDefaultOnly}"/>

              <Button Classes="SidebarAction" Content="Refresh Table" Margin="0,10,0,0"
                      Command="{Binding RefreshTableCommand}"
                      ToolTip.Tip="Reprocesses the vehicle's already-downloaded parameters into the grid - no network round-trip."/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
