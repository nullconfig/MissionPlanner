<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MissionPlanner.Prototypes.Avalonia.Parameters"
             x:Class="MissionPlanner.Prototypes.Avalonia.Parameters.ParametersView"
             x:DataType="vm:ParametersViewModel">

  <!--
    Chunk 1 of Config's real "Full Parameter List" page (GCSViews/ConfigurationView/
    ConfigRawParams.cs - see .okf/config-tuning/parameters/overview.md) - a live,
    searchable, read-only table of every real parameter on the connected vehicle, plus
    the real left-side parameter-group tree (ConfigRawParams.cs's treeView1/BuildTree(),
    added 2026-08-16 - see ParametersViewModel.cs's BuildGroupTree for the ported
    algorithm). Column set (Name/Value/Default/Units/Options/Desc) matches the real
    screen exactly, verified against ConfigRawParams.Designer.cs/.resx (2026-08-16 -
    chunk 1 originally shipped with a guessed, wrong column set:
    Name/Value/Units/DisplayName/Description). Deliberately not the DataGridView
    grid-editing/param-compare/save-load/Fav-favorites/action-panel feature set the real
    screen has; those are later chunks once this one's reviewed.

    Visual language (cards, dark palette, CardHeading) copied verbatim from
    ../DemoApp/App.axaml, same self-contained-per-bundle pattern every other bundle here
    follows - see ../../../.okf/modernization/design-system/ for the shared reference
    and why byte-identical copying (not retyping from memory) matters.
  -->

  <UserControl.Resources>
    <SolidColorBrush x:Key="CardBg" Color="#171A21"/>
    <SolidColorBrush x:Key="CardBorder" Color="#262B36"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8B93A7"/>
    <x:Double x:Key="ControlHeight">36</x:Double>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.Card">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 2 10 0 #40000000"/>
    </Style>
    <Style Selector="TextBlock.CardHeading">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#1F2430"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- DataGrid ships its own default theme, not this bundle's dark palette - override
         the parts that would otherwise show through as a light/default-themed table
         inside an otherwise all-dark card. -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="RowBackground" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="VerticalGridLinesBrush" Value="{StaticResource CardBorder}"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#1F2430"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#1F2430"/>
    </Style>

    <!-- Left-side parameter-group tree (ConfigRawParams.cs's treeView1/BuildTree()) -
         ships its own default theme too, same reasoning as DataGrid above. -->
    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#1F2430"/>
    </Style>
    <Style Selector="TreeViewItem:selected TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="Card" Padding="16">
    <DockPanel>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
        <TextBlock Grid.Column="0" Text="PARAMETERS" Classes="CardHeading" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding SearchText}" Watermark="Search parameters (matches any column, e.g. ATC_RAT)"
                  Height="{StaticResource ControlHeight}" MaxWidth="380" Margin="16,0"/>
        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}"
                   FontSize="12" VerticalAlignment="Center"/>
      </Grid>

      <!-- Tree (left) + grid (right), matching ConfigRawParams.cs's own
           splitContainer1 (Panel1 = treeView1, Panel2 = Params). Selecting a node
           narrows the grid to that group's params (see ParametersViewModel's
           SelectedGroup/ApplyFilter) - not a separate pane that needs its own
           scroll/search, just another filter over the same Rows. -->
      <Grid ColumnDefinitions="200,12,*">
        <Border Grid.Column="0" Background="#12151B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6">
          <TreeView ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Padding="4">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" FontFamily="Consolas,Menlo,monospace"/>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>

        <DataGrid Grid.Column="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  CanUserReorderColumns="True" CanUserResizeColumns="True">
          <!-- Header text and order match the real ConfigRawParams.resx exactly
               (Name/Value/Default/Units/Options/Desc) - see ParametersViewModel.cs's
               ParameterRowViewModel for where each one's real data comes from. Fav
               (favorites checkbox) is the one real column not here yet - out of scope
               for this chunk, see the OKF bundle's "Next immediate step"/chunk list. -->
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" FontFamily="Consolas,Menlo,monospace"/>
            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="90"/>
            <DataGridTextColumn Header="Default" Binding="{Binding DefaultText}" Width="90"/>
            <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="70"/>
            <DataGridTextColumn Header="Options" Binding="{Binding Options}" Width="180"/>
            <DataGridTextColumn Header="Desc" Binding="{Binding Description}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
