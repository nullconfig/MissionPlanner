<Project Sdk="Microsoft.NET.Sdk">

  <!--
    App shell for the per-tab Avalonia bundles (ConfigMotorTest, FlightData, FlightPlan,
    InitialSetup, Simulation, Terminal, Help - see README.md's "Bundles" section) that
    together mirror Mission Planner's own top-level screens (MainV2.Designer.cs:
    MenuFlightData..MenuHelp). Connects a real MAVLinkInterface (USB serial or UDP)
    instead of mocking one. Deliberately has NO reference to MissionPlanner.csproj: that
    project targets net472 and pulls in System.Windows.Forms, which a net8 app cannot
    load on Linux. Each bundle instead references
    ExtLibs/ArduPilot/MissionPlanner.ArduPilot.csproj (netstandard2.0, zero WinForms)
    directly where it needs live vehicle data - see ConfigMotorTest.csproj's own comment
    header for the decoupling this all depends on.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
    <!-- AvaloniaUI's own docking library (wieslawsoltes/Dock) - adopted after
         researching ArduDeck (an Electron/React GCS the user referenced): its
         distinctive dockable-panel/pop-out/saved-layout UX comes from "dockview"
         (a React docking library), and Dock.Avalonia is the direct Avalonia
         equivalent, not an Electron port of dockview itself. Version pinned to
         12.1.0.1 to match this app's own Avalonia 12.1.1.

         Dock.Model.Avalonia (the AvaloniaObject-based model flavor), not
         Dock.Model.ReactiveUI - tried ReactiveUI first to match every ViewModel
         elsewhere in this app, but it triggers a real, unresolved version conflict:
         Dock.Model.ReactiveUI pulls in a newer ReactiveUI/Splat than
         Avalonia.ReactiveUI 11.3.x (the newest available - no 12.x release exists
         yet to match this app's Avalonia 12.1.1) can call into
         (System.MissingMethodException: Splat.Locator.get_CurrentMutable() at
         runtime, past what the compiler catches). Dock.Model.Avalonia has the
         identical Document/Context API shape (confirmed via metadata inspection
         before switching) and no ReactiveUI/Splat dependency at all, sidestepping
         the conflict entirely - this app's own ViewModels keep using ReactiveUI
         directly, unaffected; only this one Dock integration point differs. -->
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.1" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConfigMotorTest\ConfigMotorTest.csproj" />
    <ProjectReference Include="..\FlightData\FlightData.csproj" />
    <ProjectReference Include="..\FlightPlan\FlightPlan.csproj" />
    <ProjectReference Include="..\InitialSetup\InitialSetup.csproj" />
    <ProjectReference Include="..\Simulation\Simulation.csproj" />
    <ProjectReference Include="..\Terminal\Terminal.csproj" />
    <ProjectReference Include="..\Help\Help.csproj" />
    <ProjectReference Include="..\Parameters\Parameters.csproj" />
  </ItemGroup>

</Project>
